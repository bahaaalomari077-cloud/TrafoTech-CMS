{
  "Logging": {
    "IncludeScopes": false,
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "TrafoTech": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200",
      "http://localhost:4300"
    ]
  },
  "OrchardCore": {
    "Default": {
      "State": "Uninitialized",
      "DatabaseProvider": "Postgres",
      "TablePrefix": ""
    },
    "OrchardCore_Media": {
      "AllowedFileExtensions": [
        ".jpg", ".jpeg", ".png", ".gif", ".webp", ".svg", ".ico",
        ".pdf", ".docx", ".xlsx",
        ".mp4", ".webm"
      ]
    }
  }
}
