{
  "name": "TrafoTech.Headless",
  "displayName": "TrafoTech Headless",
  "description": "Headless CMS for the TrafoTech site. Content types and starter content are created by migrations in TrafoTech.Admin, so this recipe only enables features and applies settings.",
  "author": "TrafoTech",
  "website": "https://trafotech.local",
  "version": "1.0.0",
  "issetuprecipe": true,
  "categories": [
    "headless"
  ],
  "tags": [
    "headless",
    "graphql",
    "api",
    "localization"
  ],
  "steps": [
    {
      "name": "feature",
      "enable": [
        "OrchardCore.Contents",
        "OrchardCore.ContentTypes",
        "OrchardCore.ContentFields",
        "OrchardCore.ContentPreview",
        "OrchardCore.Title",
        "OrchardCore.Autoroute",
        "OrchardCore.Alias",
        "OrchardCore.Html",
        "OrchardCore.Markdown",
        "OrchardCore.Media",
        "OrchardCore.Taxonomies",
        "OrchardCore.Lists",
        "OrchardCore.Flows",
        "OrchardCore.Widgets",
        "OrchardCore.Forms",
        "OrchardCore.Indexing",
        "OrchardCore.Search.Lucene",
        "OrchardCore.Localization",
        "OrchardCore.ContentLocalization",
        "OrchardCore.Apis.GraphQL",
        "OrchardCore.Queries",
        "OrchardCore.Liquid",
        "OrchardCore.Settings",
        "OrchardCore.Recipes",
        "OrchardCore.Deployment",
        "OrchardCore.Roles",
        "OrchardCore.Users",
        "OrchardCore.OpenId",
        "OrchardCore.OpenId.Management",
        "OrchardCore.OpenId.Server",
        "OrchardCore.OpenId.Validation",
        "OrchardCore.AdminMenu",
        "OrchardCore.Diagnostics",
        "OrchardCore.Resources",
        "OrchardCore.Admin",
        "OrchardCore.Navigation",
        "OrchardCore.Themes",
        "TheAdmin",
        "TrafoTech.Admin"
      ]
    },
    {
      "name": "themes",
      "admin": "TheAdmin"
    },
    {
      "name": "settings",
      "HomeRoute": {
        "Action": "Index",
        "Controller": "Admin",
        "Area": "OrchardCore.Admin"
      },
      "LocalizationSettings": {
        "DefaultCulture": "en",
        "SupportedCultures": [
          "en",
          "ar"
        ]
      }
    },
    {
      "name": "Roles",
      "Roles": [
        {
          "Name": "Anonymous",
          "Description": "Anonymous role",
          "Permissions": [
            "ViewContent",
            "ExecuteGraphQL",
            "QueryLuceneApi"
          ]
        },
        {
          "Name": "Authenticated",
          "Description": "Authenticated role",
          "Permissions": [
            "ViewContent",
            "ExecuteGraphQL",
            "QueryLuceneApi"
          ]
        },
        {
          "Name": "Editor",
          "Description": "Creates and publishes site content",
          "Permissions": [
            "ViewContent",
            "PublishContent",
            "EditContent",
            "DeleteContent",
            "PreviewContent",
            "ManageMedia",
            "ManageOwnMedia",
            "ExecuteGraphQL"
          ]
        }
      ]
    },
    {
      "name": "lucene-index",
      "Indices": [
        {
          "Search": {
            "AnalyzerName": "standard",
            "IndexLatest": false,
            "IndexedContentTypes": [
              "Page",
              "Service",
              "BlogPost"
            ],
            "Culture": "any",
            "StoreSourceData": true
          }
        }
      ]
    }
  ]
}
